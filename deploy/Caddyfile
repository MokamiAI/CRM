# {$DOMAIN} comes from .env (e.g. app.ygt.co.za). Caddy gets and renews the
# HTTPS certificate on its own once the domain points at this server.
{$DOMAIN} {
	encode zstd gzip

	# The API (and the public webhook/unsubscribe links it serves).
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /health {
		reverse_proxy backend:8000
	}

	# The web app: real files first, everything else is a page of the app.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
	}

	header {
		# Only YGT's own scripts may run. Inline styles are allowed (the app
		# sets some colours and sizes inline); logos may come from any https
		# address. A smuggled script tag in a customer's name would be blocked.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; frame-src 'self' blob:; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}
}
