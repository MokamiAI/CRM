# Base URL the frontend calls for the API.
#
# Web dev server (docker compose / `npm run dev`): the default below
# (localhost:8000) works, since the browser and backend share your machine.
#
# Native mobile builds (Capacitor/Android/iOS): the built web assets are
# bundled INTO the app at build time, not loaded from a live dev server, so
# "localhost" means the phone itself, not your dev machine. Point this at a
# real, HTTPS-reachable backend URL before running `npm run cap:sync` — an
# Android emulator can reach your machine at 10.0.2.2, but a physical device
# or the iOS simulator cannot reach "localhost" at all. Both iOS App
# Transport Security and Android's default network security config also
# block plain http:// in release builds, so this must be https:// for
# anything other than local emulator testing.
VITE_API_BASE_URL=http://localhost:8000/api/v1
