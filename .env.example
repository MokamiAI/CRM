# Copy to .env (git-ignored) and fill in real values. Never put real
# passwords or keys in this file: it is committed to git.

# ---- Database (Supabase Postgres) ----
# Supabase > Project Settings > Database > Connection pooling.
# Use the pooler host for your project's region and the user
# "postgres.<project-ref>". URL-encode special characters in the password
# (# -> %23, @ -> %40, : -> %3A, / -> %2F, % -> %25).
# App runtime traffic: transaction pooler (port 6543)
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
# Alembic migrations: session pooler (port 5432)
DATABASE_URL_MIGRATIONS=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Encrypts the passwords and API tokens companies enter in Settings
# (email, WhatsApp, SMS). Generate once and keep it safe: losing it means
# every company must re-enter those credentials.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0

# ---- Email (SMTP now; swap EMAIL_PROVIDER later for sendgrid/ses/mailgun) ----
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=billing@example.com
SMTP_FROM_NAME=CRM System

# ---- Two-way customer email (Messages inbox) ----
# Replies to inbox emails go to reply+<thread>@INBOUND_EMAIL_DOMAIN. Point
# that domain's MX records at your mail provider's inbound parsing
# (Mailgun Routes, SendGrid Inbound Parse, Postmark Inbound...) and have it
# POST to <PUBLIC_API_URL>/api/v1/public/inbound/email with the header
# X-Inbound-Secret: <INBOUND_EMAIL_SECRET>.
INBOUND_EMAIL_DOMAIN=inbound.example.com
INBOUND_EMAIL_SECRET=change-me-to-a-long-random-string

# ---- Links in emails (unsubscribe, open tracking) ----
# The public address of this API once deployed.
PUBLIC_API_URL=http://localhost:8000

# ---- Subscriptions (Paystack) ----
# YGT's own Paystack account: dashboard > Settings > API Keys & Webhooks.
# Use the sk_test_ key until you're ready to take real money, then sk_live_.
# On the same page set the webhook URL to
#   <PUBLIC_API_URL>/api/v1/public/paystack/webhook
# Plans are created in Paystack automatically the first time someone picks them.
PAYSTACK_SECRET_KEY=
# Where the web app lives; Paystack sends people back here after paying.
FRONTEND_URL=http://localhost:5173
# Free trial of the Grow plan for new companies, in days.
TRIAL_DAYS=14

# ---- Company defaults for new sign-ups ----
COMPANY_NAME=My Company
DEFAULT_CURRENCY=ZAR
DEFAULT_TIMEZONE=Africa/Johannesburg

# ---- CORS ----
# capacitor://localhost and https://localhost are the default origins the
# Android/iOS Capacitor app sends requests from; keep them even in
# production so the mobile apps can reach the API.
CORS_ORIGINS=["http://localhost:5173","capacitor://localhost","https://localhost"]

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
