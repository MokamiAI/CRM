# ---- Database (Supabase Postgres) ----
# App runtime traffic: Supabase "Transaction pooler" connection string (port 6543)
DATABASE_URL=postgresql+asyncpg://postgres:<password>@<project-ref>.pooler.supabase.com:6543/postgres
# Alembic migrations: Supabase "Session pooler" or direct connection (port 5432)
DATABASE_URL_MIGRATIONS=postgresql+asyncpg://postgres:<password>@<project-ref>.pooler.supabase.com:5432/postgres

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0

# ---- Email (SMTP now; swap EMAIL_PROVIDER later for sendgrid/ses/mailgun) ----
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=billing@example.com
SMTP_FROM_NAME=CRM System

# ---- Company defaults ----
COMPANY_NAME=My Company
DEFAULT_CURRENCY=ZAR
DEFAULT_TIMEZONE=Africa/Johannesburg

# ---- CORS ----
CORS_ORIGINS=["http://localhost:5173"]

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
