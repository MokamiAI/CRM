# ---- Database (Supabase Postgres) ----#Crm2026@123
# App runtime traffic: Supabase "Transaction pooler" connection string (port 6543)
DATABASE_URL=postgresql://postgres:#Crm2026@123@db.dxrnrlzlssahkobkbptp.supabase.co:5432/postgres
# Alembic migrations: Supabase "Session pooler" or direct connection (port 5432)
DATABASE_URL_MIGRATIONS=postgresql+asyncpg://postgres:#Crm2026@123@<project-ref>.pooler.supabase.com:5432/postgres

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0

# ---- Email (SMTP now; swap EMAIL_PROVIDER later for sendgrid/ses/mailgun) ----
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=billing@example.com
SMTP_FROM_NAME=CRM System

# ---- Company defaults ----
COMPANY_NAME=My Company
DEFAULT_CURRENCY=ZAR
DEFAULT_TIMEZONE=Africa/Johannesburg

# ---- CORS ----
# capacitor://localhost and https://localhost are the default origins the
# Android/iOS Capacitor app sends requests from; keep them even in
# production so the mobile apps can reach the API.
CORS_ORIGINS=["http://localhost:5173","capacitor://localhost","https://localhost"]

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
