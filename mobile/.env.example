# Base URL the mobile app calls for the API. Expo Go on a physical phone or
# a simulator is never "localhost" of your dev machine — set this to your
# machine's LAN IP (e.g. http://10.10.49.51:8000/api/v1, same network as
# your phone) or a real deployed HTTPS backend URL. Also add that origin —
# or just allow it broadly for LAN testing — to the backend's CORS_ORIGINS.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
